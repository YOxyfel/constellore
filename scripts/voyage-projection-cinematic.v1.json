  "shots": [
    {
      "id": "earth",
      "startSeconds": 0,
      "endSeconds": 7,
      "setting": "earth-departure",
      "storyBeat": "The projection wakes over Earth and establishes the player-sized rocket against a reachable world.",
      "cameraIntent": "Grounded, slow rise, readable horizon; no roll.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d", "dust-matte-3d"],
      "aiPassIds": ["ai-deep-field", "ai-dust-volume"]
    },
    {
      "id": "solar",
      "startSeconds": 7,
      "endSeconds": 20,
      "setting": "solar-system",
      "storyBeat": "The rocket crosses the known solar worlds; completed coordinates materialize while future planets remain distant.",
      "cameraIntent": "One continuous lateral pursuit with restrained parallax and no orbiting camera roll.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d", "dust-matte-3d"],
      "aiPassIds": ["ai-deep-field", "ai-dust-volume"]
    },
    {
      "id": "heliopause",
      "startSeconds": 20,
      "endSeconds": 27,
      "setting": "heliopause",
      "storyBeat": "Known sunlight thins and the route becomes the only stable coordinate.",
      "cameraIntent": "Locked pursuit eases wider; maintain a level horizon surrogate and legible rocket silhouette.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d", "dust-matte-3d"],
      "aiPassIds": ["ai-deep-field", "ai-dust-volume"]
    },
    {
      "id": "warp",
      "startSeconds": 27,
      "endSeconds": 38,
      "setting": "interstellar-corridor",
      "storyBeat": "The projection uses earned coordinates to fold distance without inventing new destinations.",
      "cameraIntent": "Centered pursuit, fixed roll, acceleration communicated by environment and route compression rather than camera shake.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d", "warp-matte-3d"],
      "aiPassIds": ["ai-deep-field", "ai-warp-caustics"]
    },
    {
      "id": "black-hole",
      "startSeconds": 38,
      "endSeconds": 48,
      "setting": "black-hole-approach",
      "storyBeat": "The last known light bends around a destination the map cannot name.",
      "cameraIntent": "Measured push toward the accretion plane; no handheld motion and no more than three degrees of authored roll.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d", "accretion-matte-3d"],
      "aiPassIds": ["ai-deep-field", "ai-accretion-glow"]
    },
    {
      "id": "singularity",
      "startSeconds": 48,
      "endSeconds": 53,
      "setting": "event-horizon",
      "storyBeat": "The mission projection reaches its data boundary and either collapses or resolves according to the earned variant.",
      "cameraIntent": "Axial approach with fixed roll; the singularity grows through distance, never through a synthetic zoom punch.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "singularity-matte-3d"],
      "aiPassIds": ["ai-singularity-corona"]
    },
    {
      "id": "return",
      "startSeconds": 53,
      "endSeconds": 57,
      "setting": "earth-return",
      "variants": ["promise", "progress"],
      "storyBeat": "The unresolved projection folds back to Earth and hands agency to the player: make the route.",
      "cameraIntent": "Short visual recall of Earth, stable composition, clean negative space for authored interface text.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d"],
      "aiPassIds": ["ai-deep-field"]
    },
    {
      "id": "beyond",
      "startSeconds": 53,
      "endSeconds": 57,
      "setting": "beyond-singularity",
      "variants": ["completion"],
      "storyBeat": "The completed projection continues beyond the old boundary into a still-unnamed field without declaring the journey finished.",
      "cameraIntent": "Stable emergence, slow parallax, no celebratory spin or montage cut.",
      "authoritativePassIds": ["beauty-3d", "depth-3d", "normal-3d", "motion-vector-3d", "object-id-3d", "far-field-matte-3d"],
      "aiPassIds": ["ai-beyond-color-field"]
    }
