  "title": "Voyage Projection",
  "durationSeconds": 57,
  "intent": {
    "opening": "A navigation projection demonstrates the reachable universe, then fails at an unnamed singularity and returns the player to Earth with a route still to make.",
    "finale": "The same projection is completed by earned coordinates and continues beyond the singularity without invalidating the player's journey.",
    "tone": [
      "cinematic",
      "astronomically grounded",
      "calm",
      "awe before spectacle",
      "never trailer-like"
    ],
    "maximumRuntimeSeconds": 60
  },
